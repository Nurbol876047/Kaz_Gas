# Copy to .env. Generate independent random values; never commit .env.
# python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_USER=utility
POSTGRES_DB=utility
POSTGRES_PASSWORD=
# Use URL-safe hex passwords or URL-encode credentials in URLs.
DATABASE_URL=postgresql+asyncpg://utility:REPLACE_DB_PASSWORD@postgres:5432/utility
REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/0
BOT_REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/1
BOT_API_KEY=
BOT_TOKEN=
ALLOWED_ORIGINS=https://utility.example.kz
ENVIRONMENT=production
COOKIE_SECURE=true
# Optional: enables an automatic check that a submitted meter-reading photo actually
# shows a gas meter (Gemini vision). Leave blank to skip the check; readings are then
# reviewed by an admin only, same as before.
GEMINI_API_KEY=
